      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ===== CONFIG =====\nconst ALLOWED_CHAT_ID = '5183799755';   // আসল Chat ID, quote-এর ভেতরে, minus চিহ্ন সহ\nconst ALLOWED_USER_IDS = ['5183799755'];    // আসল User ID\n\nconst cq = $json.callback_query || {};\nconst data = String(cq.data || '');\nconst m = data.match(/^claim:(L-[A-Z0-9]+)$/);   // কেবল প্রত্যাশিত ফরম্যাট\n\nconst chatId = String(cq.message?.chat?.id ?? '');\nconst userId = String(cq.from?.id ?? '');\nconst authorized =\n  chatId === ALLOWED_CHAT_ID &&\n  (ALLOWED_USER_IDS.length === 0 || ALLOWED_USER_IDS.includes(userId));\n\nconst f = cq.from || {};\nconst claimerName =\n  [f.first_name, f.last_name].filter(Boolean).join(' ') || f.username || userId;\n\nreturn {\n  json: {\n    valid: Boolean(m) && authorized,\n    lead_id: m ? m[1] : '',\n    query_id: cq.id || '',\n    chat_id: chatId,\n    message_id: cq.message?.message_id,\n    orig_text: cq.message?.text || '',\n    claimer_name: claimerName\n  }\n};"
      },
