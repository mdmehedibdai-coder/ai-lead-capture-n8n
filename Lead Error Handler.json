    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json.execution || {};\nconst w = $json.workflow || {};\n\n// গোপন তথ্য ও ব্যক্তিগত তথ্য মুছে ফেলা + দৈর্ঘ্য সীমিত\nconst redact = (s) => String(s ?? '')\n  .replace(/\\b\\d{6,}:[A-Za-z0-9_-]{30,}\\b/g, '[REDACTED_TOKEN]')\n  .replace(/\\bsk-[A-Za-z0-9_-]{10,}\\b/g, '[REDACTED_KEY]')\n  .replace(/Bearer\\s+[A-Za-z0-9._~+\\/-]+=*/gi, 'Bearer [REDACTED]')\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[REDACTED_EMAIL]')\n  .slice(0, 300);\n\nconst workflowName = redact(w.name);\nconst failedNode = redact(e.lastNodeExecuted);\nconst errorMessage = redact(e.error?.message);\nconst url = String(e.url || '');\n\nconst alertText = [\n  '🛑 WORKFLOW ERROR',\n  `Workflow: ${workflowName}`,\n  `Failed node: ${failedNode}`,\n  `Error: ${errorMessage}`,\n  `Execution: ${url}`\n].join('\\n');\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow_name: workflowName,\n    workflow_id: String(w.id || ''),\n    execution_id: String(e.id || ''),\n    failed_node: failedNode,\n    error_message: errorMessage,\n    execution_url: url,\n    alert_text: alertText\n  }\n};"
      },
